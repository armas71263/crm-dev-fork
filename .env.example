# ---- Core (required)
KEY=replace-with-32-byte-key
SECRET=replace-with-32-byte-or-longer-secret

# ---- Local dev DB (in prod use Supabase)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rubbertrack
DB_USER=postgres
DB_PASSWORD=postgres
# app_role (non-superuser; RLS applies to it — used by BFF)
PG_USER=app_role
PG_PASSWORD=apppass
PG_HOST=postgres

# ---- Directus admin
DIRECTUS_URL=http://localhost:8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
PUBLIC_URL=http://localhost:8055

# ---- BFF
BFF_PORT=4000

# ---- AI providers (at least one needed)
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
CLOUDFLARE_WORKERS_AI_APIKEY=
AI_PORT=5000
AI_SERVICE_URL=http://ai-service:5000

# ---- Web
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ---- Supabase (cloud Postgres + Auth). BFF requires these unless BFF_ALLOW_DEV_AUTH=1.
# Session pooler (IPv4-safe, session mode) — NOT the transaction pooler (breaks set_config RLS sessions).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# SERVER-ONLY. Can write app_metadata (tenant/company/plan). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SESSION_POOLER_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Customer-role requests connect as the app_customer login role (migration 003):
# same pooler host, username prefixed with the role — app_customer.YOUR-PROJECT-REF
SUPABASE_DB_CUSTOMER_POOLER_URL=postgresql://app_customer.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Product analytics (PostHog Cloud free tier)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
