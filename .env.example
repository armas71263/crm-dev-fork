# ---- Core (required)
KEY=replace-with-32-byte-key
SECRET=replace-with-32-byte-or-longer-secret

# ---- Local dev DB (in prod use Supabase)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rubbertrack
DB_USER=postgres
DB_PASSWORD=postgres
# app_role (non-superuser; RLS applies to it — used by BFF)
PG_USER=app_role
PG_PASSWORD=apppass
PG_HOST=postgres

# ---- Directus admin
DIRECTUS_URL=http://localhost:8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
PUBLIC_URL=http://localhost:8055

# ---- BFF
BFF_PORT=4000

# ---- AI providers (at least one needed)
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
CLOUDFLARE_WORKERS_AI_APIKEY=
AI_PORT=5000
AI_SERVICE_URL=http://ai-service:5000

# ---- Web
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ---- Supabase (cloud Postgres + Auth). BFF requires these unless BFF_ALLOW_DEV_AUTH=1.
# All three use the SESSION pooler (port 5432) — never the transaction pooler
# (port 6543 breaks session-level set_config) and never the IPv6-only direct DSN.
# Staff pool connects as the app_role LOGIN role (RLS applies); migrations/admin
# as postgres; customer requests as app_customer (created by migration 003).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# SERVER-ONLY. Can write app_metadata (tenant/company/plan). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SESSION_POOLER_URL=postgresql://app_role.YOUR-PROJECT-REF:APP_ROLE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_ADMIN_POOLER_URL=postgresql://postgres.YOUR-PROJECT-REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_CUSTOMER_POOLER_URL=postgresql://app_customer.YOUR-PROJECT-REF:CUSTOMER_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Product analytics (PostHog Cloud free tier)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
