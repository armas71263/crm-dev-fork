# ---- Core (required)
KEY=replace-with-32-byte-key
SECRET=replace-with-32-byte-or-longer-secret

# ---- Local dev DB (in prod use Supabase)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rubbertrack
DB_USER=postgres
DB_PASSWORD=postgres
# app_role (non-superuser; RLS applies to it — used by BFF)
PG_USER=app_role
PG_PASSWORD=apppass
PG_HOST=postgres

# ---- Directus admin
DIRECTUS_URL=http://localhost:8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
PUBLIC_URL=http://localhost:8055

# ---- BFF
BFF_PORT=4000

# ---- AI providers (at least one needed)
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
CLOUDFLARE_WORKERS_AI_APIKEY=
AI_PORT=5000
AI_SERVICE_URL=http://ai-service:5000

# ---- Web
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ---- Supabase (cloud Postgres + Auth). BFF requires these unless BFF_ALLOW_DEV_AUTH=1.
# All three use the SESSION pooler (port 5432) — never the transaction pooler
# (port 6543 breaks session-level set_config) and never the IPv6-only direct DSN.
# Staff pool connects as the app_role LOGIN role (RLS applies); migrations/admin
# as postgres; customer requests as app_customer (created by migration 003).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# SERVER-ONLY. Can write app_metadata (tenant/company/plan). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SESSION_POOLER_URL=postgresql://app_role.YOUR-PROJECT-REF:APP_ROLE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_ADMIN_POOLER_URL=postgresql://postgres.YOUR-PROJECT-REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_CUSTOMER_POOLER_URL=postgresql://app_customer.YOUR-PROJECT-REF:CUSTOMER_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_READONLY_POOLER_URL=postgresql://app_readonly.YOUR-PROJECT-REF:READONLY_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Directus control plane (vendor-only; directus_admin role = migration 006)
# Directus cannot connect as postgres on Supabase (not a superuser there; FORCE
# RLS would show zero rows). It connects as the dedicated directus_admin login
# role via the same session pooler.
DIRECTUS_KEY=32-char-random-string
DIRECTUS_SECRET=long-random-string
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=changeme
DIRECTUS_DB_HOST=aws-0-REGION.pooler.supabase.com
DIRECTUS_DB_PORT=5432
DIRECTUS_DB_DATABASE=postgres
DIRECTUS_DB_USER=directus_admin.YOUR-PROJECT-REF
DIRECTUS_DB_PASSWORD=STRONG_PASSWORD
DIRECTUS_DB_SSL=true
DIRECTUS_DB_SSL_REJECT_UNAUTHORIZED=false
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ---- Product analytics (PostHog Cloud free tier)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Web app (apps/web/.env.local in dev; compose env in prod)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
NEXT_PUBLIC_BFF_URL=http://localhost:4000

# Cloudflare Workers AI via the AI Gateway — real LLM (@cf/qwen/qwen3.8-27b,
# function calling) and embeddings (@cf/baai/bge-base-en-v1.5, 768-d).
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default
CLOUDFLARE_LLM_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5

# Predictions service (Phase 5) — damped-ETS forecasts; Chronos-Bolt opt-in via PREDICTIONS_USE_CHRONOS=1
PREDICTIONS_SERVICE_URL=http://localhost:5100

# Phase 6.5: shared secret for the BFF internal gateway (AI service -> BFF; never exposed to browsers)
BFF_INTERNAL_TOKEN=change-me-internal-gateway-secret
