{
  "_comment": "Module registry — defines which modules each template enables. Drives the dynamic module system (Phase 1). Adding a module here + a tenant template reference turns it on per-tenant without code changes.",
  "modules": {
    "dashboard": {
      "label": "Dashboard",
      "kind": "summary",
      "collections": ["records", "tickets", "parties", "feed_items"]
    },
    "companies": {
      "label": "Companies",
      "kind": "crud",
      "collections": ["companies"]
    },
    "contacts": {
      "label": "Contacts",
      "kind": "crud",
      "collections": ["contacts"]
    },
    "leads": {
      "label": "Leads",
      "kind": "crud",
      "collections": ["leads"]
    },
    "deals": {
      "label": "Deals",
      "kind": "crud",
      "collections": ["deals", "pipeline_stages"]
    },
    "activities": {
      "label": "Activities",
      "kind": "crud",
      "collections": ["activities"],
      "views": {"tasks": "type=task", "notes": "type=note", "calls": "type=call"}
    },
    "pipeline": {
      "label": "Pipeline Settings",
      "kind": "config",
      "collections": ["pipeline_stages"]
    },
    "records": {
      "label": "Order Records",
      "kind": "crud",
      "collections": ["records"]
    },
    "parties": {
      "label": "Parties",
      "kind": "crud",
      "collections": ["parties"],
      "splits": {"supplier": "Suppliers", "customer": "Customers"}
    },
    "tickets": {"label": "Issues", "kind": "crud", "collections": ["tickets"]},
    "attendance": {
      "label": "Attendance",
      "kind": "crud",
      "collections": ["hr_events"]
    },
    "news": {
      "label": "News Feed",
      "kind": "cms",
      "collections": ["feed_items"]
    },
    "docs": {
      "label": "Doc Tools",
      "kind": "ai",
      "collections": ["files"],
      "requires": ["embeddings"]
    },
    "checklists": {
      "label": "Checklists",
      "kind": "crud",
      "collections": ["checklists"]
    }
  },
  "templates": {
    "rubbertrack": {
      "label": "RubberTrack",
      "enabled": [
        "dashboard",
        "companies",
        "contacts",
        "leads",
        "deals",
        "activities",
        "pipeline",
        "records",
        "parties",
        "tickets",
        "attendance",
        "news",
        "docs",
        "checklists"
      ]
    },
    "services": {
      "label": "Generic Services (CRM core)",
      "enabled": [
        "dashboard",
        "companies",
        "contacts",
        "leads",
        "deals",
        "activities",
        "pipeline",
        "news",
        "docs",
        "checklists"
      ]
    }
  }
}
